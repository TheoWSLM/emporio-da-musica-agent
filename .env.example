# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=

# --- Optional: Jev (TypeSafe AI) classifier case study ----------------------
# Leave empty and everything works the same through the OpenAI classifier.
TYPESAFE_API_KEY=
CLASSIFIER_PROVIDER=auto        # auto (Jev when a key is present) | openai | jev

# --- Models -------------------------------------------------------------------
AGENT_MODEL=gpt-6.1-terra
CLASSIFIER_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
# Extra LLM review of every reply (the deterministic grounding/leak checks always run).
OUTPUT_REVIEW=false

# --- Business clock ------------------------------------------------------------
APP_TIMEZONE=America/Campo_Grande
# The sample data ends in 03/2026. Set a date to demo returns inside their window.
APP_REFERENCE_DATE=

# --- Runtime -------------------------------------------------------------------
EDGE_PORT=18082                 # local port of the web UI (bound to 127.0.0.1)
POSTGRES_PASSWORD=emporio
RELEASE_ID=local

# --- Public demo protection ----------------------------------------------------
RATE_LIMIT_PER_IP=20            # messages per IP per 10 minutes
MAX_TURNS_PER_CONVERSATION=40
RATE_LIMIT_GLOBAL_PER_DAY=1000
