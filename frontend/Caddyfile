{
	admin off
	auto_https off
	servers {
		# Behind the Cloudflare tunnel the client IP arrives in Cf-Connecting-Ip from a private network.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	# Access log without URI or headers (no personal data), like the other apps on the server.
	log {
		output stdout
		format filter {
			request>uri delete
			request>headers delete
			resp_headers delete
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
		-Server
	}

	handle_path /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			# Server-Sent Events: stream every event as soon as it is produced.
			flush_interval -1
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
